{
  "productName": "webptools",
  "version": "0.1.0",
  "identifier": "io.github.camiha.webptools",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": { "csp": null },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "webptools",
        "width": 400,
        "height": 600,
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/camiha/webptools/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1OTNEOTVGMDVBNEM2RDYKUldUV3hxUUZYOW1UNVNwWDVxalJBUWI2RjIzR1JiMTJTY1NIRFFobHZWcFFJNUVXNDZ4c2x2OXMK"
    }
  }
}
